<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- LAMPA 效果①：全局背景层。焦点移到哪张海报，全屏就交叉淡入那张海报（居中裁剪铺满）。
         竖海报 centerCrop 后上下会被裁掉一些，但中间区域（最显眼）完整保留。 -->
    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:background="#FF1D1F20" />

    <!-- 压暗层：LAMPA 官方是 canvas 自带 opacity:0.5，这里用半透明黑 #881D1F20 叠在海报上，
         让背景「永远呼吸但内容永远可读」 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#881D1F20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:padding="8dp">

    <!-- LAMPA 效果④：首页 Hero 大条目（第一屏大卡，数据来自当前版块第一页第一条） -->
    <include layout="@layout/item_hero" />

    <!-- 分类行 + 搜索按钮：分类横向滚动，搜索按钮在“设置”后面 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:gravity="center_vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="🔍 搜索"
            android:textColor="#FFFFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#FF2A3038" />

    <!-- 过滤器行：各版块的主题分类（每版块不同，搜索模式隐藏） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 影片区：列表 + 居中空态提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:clipChildren="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="加载中…"
            android:textColor="#FF9AA0A6"
            android:textSize="13sp"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>

    </LinearLayout>
</FrameLayout>
