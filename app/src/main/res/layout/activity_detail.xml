<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 海报 + 片名/信息/简介 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDetailPic"
                android:layout_width="150dp"
                android:layout_height="212dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_movie_normal"
                android:contentDescription="影片海报"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="20"
                    android:textColor="#FFC6CBD2"
                    android:textSize="14sp" />

                <!-- ◎上映日期 往下的整块正文（◎IMDb评分 → 简介 → 片尾说明）：屏幕上最多 8 行。
                     8 是折行后的行数，所以只能靠 maxLines 限；按需求超出直接截掉（带省略号）。 -->
                <TextView
                    android:id="@+id/tvDetailIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="8"
                    android:textColor="#FFC6CBD2"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 分集：只有「一集一条记录」的剧才有（onCreate 之后异步查 seriesEpisodes 填充）。
             横向小海报，样式跟首页海报墙一致；点某一集 = 只下那一集。 -->
        <LinearLayout
            android:id="@+id/llSeriesBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="分集"
                    android:textColor="#FF1E88E5"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDownloadAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_action_download"
                    android:focusable="true"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:text="⬇ 全下"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llEpisodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvSeriesTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF9AA0A6"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActionsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="操作"
            android:textColor="#FF1E88E5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_play"
                android:focusable="true"
                android:paddingStart="26dp"
                android:paddingTop="14dp"
                android:paddingEnd="26dp"
                android:paddingBottom="14dp"
                android:text="▶ 在线播放"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_action_download"
                android:focusable="true"
                android:paddingStart="26dp"
                android:paddingTop="14dp"
                android:paddingEnd="26dp"
                android:paddingBottom="14dp"
                android:text="⬇ 下载"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_action_transfer"
                android:focusable="true"
                android:paddingStart="26dp"
                android:paddingTop="14dp"
                android:paddingEnd="26dp"
                android:paddingBottom="14dp"
                android:text="⇪ 转存"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTransferDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF9AA0A6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTransferResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF9AA0A6"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
