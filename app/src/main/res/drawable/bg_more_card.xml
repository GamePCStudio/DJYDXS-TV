<?xml version="1.0" encoding="utf-8"?>
<!--
  行尾「更多」卡（SAM-CINEMA 的 ItemVodMore）。

  故意做成「虚线感的空心卡」：实心卡会被误认成又一张海报，
  空心 + 加号 + 居中文字一眼就能看出是「还有更多」。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33FFFFFF" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="7dp" android:color="#3342A5F5" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="#FF42A5F5" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
