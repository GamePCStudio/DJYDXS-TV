<?xml version="1.0" encoding="utf-8"?>
<!--
  LAMPA 效果②白描边焦点框：独立叠加层（盖在海报图之上）。
  透明底 + 3dp 纯白外描边 + 8dp 圆角，对齐 LAMPA .card__view::after
  （top/left/right/bottom:-0.5em 外扩 + 0.3em 白描边 + 1.4em 圆角）。
  平时整层 GONE，焦点拿到时 VISIBLE —— 海报之上直接可见，不再被图盖住。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="3dp" android:color="#FFFFFFFF" />
    <corners android:radius="8dp" />
</shape>
